# -----------------------------------------------------------------------------
# Gymbox environment variables
# Copy this file to .env.local and fill in real values:  cp .env.example .env.local
# Never commit .env.local. Only variables prefixed with NEXT_PUBLIC_ are exposed
# to the browser — keep every secret WITHOUT that prefix.
# -----------------------------------------------------------------------------

# --- App ---------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=Gymbox
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase ----------------------------------------------------------------
# Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Server-only. Bypasses Row Level Security — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Dashboard > Project Settings > API > JWT Settings (optional, for verifying tokens server-side)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Dashboard > Project Settings > Database > Connection string (for migrations / ORM)
# Pooled connection (Transaction mode, port 6543) for the app runtime
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct connection (port 5432) for running migrations
DIRECT_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:5432/postgres

# --- Cloudflare R2 (S3-compatible storage) -----------------------------------
# Cloudflare dashboard > R2 > Manage R2 API Tokens
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=gymbox
# Usually https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com
R2_REGION=auto
# Public URL for serving files (r2.dev subdomain or a custom domain bound to the bucket)
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-xxxxxxxxxxxx.r2.dev
# Max upload size in bytes (default 5 MB)
MAX_UPLOAD_SIZE_BYTES=5242880

# --- Admin seed --------------------------------------------------------------
# Used once by the seed script to create the first admin account.
# Use a strong password and change it after first login.
SEED_ADMIN_EMAIL=admin@yourdomain.com
SEED_ADMIN_PASSWORD=change-me-to-a-strong-password
SEED_ADMIN_NAME="Gymbox Admin"

# --- Auth / security ---------------------------------------------------------
# Where Supabase redirects after email confirmation / OAuth sign-in
NEXT_PUBLIC_AUTH_REDIRECT_URL=http://localhost:3000/auth/callback
# Shared secret for protecting cron jobs / internal API routes. Generate: openssl rand -base64 32
CRON_SECRET=generate-a-long-random-string

# --- Email (optional — e.g. Resend for membership reminders / receipts) -------
RESEND_API_KEY=
EMAIL_FROM="Gymbox <no-reply@yourdomain.com>"
